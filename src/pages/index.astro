---
// ==========================================
// 门店基础配置与社群/外链矩阵配置区
// ==========================================
const restaurantInfo = {
  name: "徐虾客·快乐长沙菜",
  slogan: "坡子街老江湖，快乐长沙一口虾",
  description: "长沙坡子街十五年地道湘菜与江湖菜老店。荣获大众点评2026当地人推荐榜。主打金牌虾尾、口味鸡、姜辣凤爪等特色湘味，烟火气十足，本地人深夜食堂。",
  address: "长沙市天心区坡子街 7 号福临阁 1 楼（海信广场旁）",
  areaServed: "长沙五一商圈、坡子街、解放西路",
  geoCoordinates: { latitude: 28.1921, longitude: 112.9735 },
  phone: "0731-84423222",
  hours: "Mo-Su 11:00-02:00",
  priceRange: "¥50-¥60",
  // 社交平台外链与二维码配置
  socialLinks: [
    { name: "大众点评", url: "https://www.dianping.com/shop/G2pTkzDXI2q9iwlj", qrcode: "./images/qrcode-dianping.png", icon: "dianping" },
    { name: "小红书", url: "https://www.xiaohongshu.com", qrcode: "./images/qrcode-xiaohongshu.png", icon: "xiaohongshu" },
    { name: "抖音", url: "https://www.douyin.com", qrcode: "./images/qrcode-douyin.png", icon: "douyin" },
    { name: "微信公众号", url: "#", qrcode: "./images/qrcode-wechat.png", icon: "wechat" },
    { name: "视频号", url: "#", qrcode: "./images/qrcode-channels.png", icon: "channels" },
    { name: "微博", url: "https://weibo.com", qrcode: "./images/qrcode-weibo.png", icon: "weibo" }
  ],
  takeoutUrl: "https://waimai.baidu.com",
  // 地图直接导航链接（基于高德和百度地图 URI 规范）
  mapLinks: {
    amap: "https://uri.amap.com/marker?position=112.9735,28.1921&name=徐虾客快乐长沙菜(坡子街店)",
    baidu: "https://api.map.baidu.com/marker?location=28.1921,112.9735&title=徐虾客快乐长沙菜&content=坡子街7号福临阁1楼&output=html"
  }
};

const dishes = [
  {
    name: "金牌招牌虾尾 / 口味虾",
    desc: "精选优质鲜活小龙虾，秘制香辣酱汁大火爆炒，肉质紧实Q弹，麻辣鲜香直冲味蕾。",
    image: "./images/dish-1.jpg"
  },
  {
    name: "特色口味鸡",
    desc: "精选鲜嫩鸡肉与本地辣椒大火爆炒，香气浓郁，回味悠长，下饭首选。",
    image: "./images/dish-2.jpg"
  },
  {
    name: "姜辣凤爪",
    desc: "大片生姜与干辣椒慢火煨制，软糯脱骨、酱香浓郁，老口子心头好。",
    image: "./images/dish-3.jpg"
  }
];
---

<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{restaurantInfo.name} - 长沙坡子街地道湘菜老店 | 官网</title>
    <meta name="description" content={restaurantInfo.description} />
    <meta name="keywords" content="长沙徐虾客,坡子街美食,长沙口味虾,长沙湘菜馆,大众点评当地人推荐榜,长沙江湖菜" />
    
    <!-- GEO 本地化与地理位置 Meta -->
    <meta name="geo.region" content="CN-43" />
    <meta name="geo.placename" content="长沙市天心区坡子街" />
    <meta name="geo.position" content={`${restaurantInfo.geoCoordinates.latitude};${restaurantInfo.geoCoordinates.longitude}`} />
    <meta name="ICBM" content={`${restaurantInfo.geoCoordinates.latitude}, ${restaurantInfo.geoCoordinates.longitude}`} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Restaurant",
      "name": restaurantInfo.name,
      "image": "./images/hero-bg.jpg",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "坡子街7号福临阁1楼",
        "addressLocality": "长沙市",
        "addressRegion": "湖南省",
        "postalCode": "410000",
        "addressCountry": "CN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": restaurantInfo.geoCoordinates.latitude,
        "longitude": restaurantInfo.geoCoordinates.longitude
      },
      "url": "https://www.xuxiaking.cn",
      "telephone": restaurantInfo.phone,
      "servesCuisine": ["湘菜", "江湖菜", "长沙口味虾"],
      "priceRange": restaurantInfo.priceRange,
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
        "opens": "11:00",
        "closes": "02:00"
      },
      "areaServed": restaurantInfo.areaServed
    })} />
  </head>
  
  <body class="bg-red-950 text-white font-sans antialiased selection:bg-yellow-400 selection:text-red-950 overflow-x-hidden">

    <!-- 顶部导航栏：加入一键拨号与快捷跳转 -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-red-950/90 backdrop-blur-md border-b border-red-900/60">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between">
        <a href="#" class="text-base sm:text-xl font-bold tracking-wider text-yellow-400 flex items-center gap-2">
          <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 bg-red-600 rounded-full inline-block animate-pulse" aria-hidden="true"></span>
          <span class="truncate max-w-[150px] sm:max-w-none">{restaurantInfo.name}</span>
        </a>
        <div class="hidden md:flex space-x-6 text-sm font-medium text-red-100">
          <a href="#about" class="hover:text-yellow-400 transition">关于我们</a>
          <a href="#menu" class="hover:text-yellow-400 transition">招牌菜品</a>
          <a href="#contact" class="hover:text-yellow-400 transition">门店指引</a>
        </div>
        <div class="flex items-center gap-2">
          <!-- 顶部一键拨号按钮（手机端极其实用） -->
          <a href={`tel:${restaurantInfo.phone}`} class="bg-red-800 hover:bg-red-700 text-yellow-300 border border-yellow-400/30 px-3 py-1.5 rounded-full text-xs font-bold transition flex items-center gap-1">
            📞 拨号
          </a>
          <!-- 大众点评直达 -->
          <a href={restaurantInfo.socialLinks[0].url} target="_blank" rel="noopener noreferrer" 
             class="bg-yellow-400 hover:bg-yellow-300 text-red-950 px-3.5 sm:px-4 py-1.5 sm:py-2 rounded-full text-xs sm:text-sm font-bold transition shadow-md shadow-red-900/50">
            大众点评
          </a>
        </div>
      </div>
    </nav>

    <!-- 首屏 Hero 区域 -->
    <header class="relative h-screen flex items-center justify-center text-center px-4 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img src="./images/hero-bg.jpg" alt="长沙坡子街徐虾客门店氛围" class="w-full h-full object-cover opacity-25 scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-red-950 via-red-950/70 to-red-900/40"></div>
      </div>
      <div class="relative z-10 max-w-3xl mt-12 px-2">
        <span class="bg-red-600 text-yellow-300 uppercase tracking-widest text-[11px] sm:text-xs font-bold px-3 py-1 rounded-full mb-4 inline-block border border-yellow-400/30">
          大众点评 2026 当地人推荐榜上榜商户
        </span>
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-black tracking-tight mb-4 sm:mb-6 text-white drop-shadow-md">
          {restaurantInfo.name}
        </h1>
        <p class="text-base sm:text-xl text-yellow-200 mb-8 sm:mb-10 font-medium leading-relaxed drop-shadow">
          {restaurantInfo.slogan}
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-3 sm:gap-4">
          <a href="#menu" class="bg-yellow-400 hover:bg-yellow-300 text-red-950 font-bold px-7 py-3 rounded-full transition shadow-lg shadow-yellow-500/20 text-sm sm:text-base">
            浏览招牌菜品
          </a>
          <a href={restaurantInfo.takeoutUrl} target="_blank" rel="noopener noreferrer" class="border-2 border-yellow-400/60 hover:bg-yellow-400/10 text-yellow-300 font-semibold px-7 py-3 rounded-full transition text-sm sm:text-base">
            在线外卖订餐
          </a>
        </div>
      </div>
    </header>

    <!-- 关于我们区 -->
    <section id="about" class="py-16 sm:py-24 px-4 sm:px-6 max-w-5xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center">
        <div>
          <span class="text-yellow-400 text-xs font-bold tracking-widest uppercase block mb-2">Brand Story</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold mb-4 sm:mb-6 tracking-tight text-white">十五年坡子街老店，人间烟火气</h2>
          <p class="text-red-100/80 text-sm sm:text-base leading-relaxed mb-6 font-light">
            {restaurantInfo.description}
          </p>
          <div class="grid grid-cols-2 gap-4 sm:gap-6 border-t border-red-900 pt-6">
            <div>
              <p class="text-2xl sm:text-3xl font-black text-yellow-400">15年+</p>
              <p class="text-xs text-red-200/70 mt-1">坡子街地道老店沉淀</p>
            </div>
            <div>
              <p class="text-2xl sm:text-3xl font-black text-yellow-400">榜单认证</p>
              <p class="text-xs text-red-200/70 mt-1">大众点评当地人推荐榜</p>
            </div>
          </div>
        </div>
        <div class="relative h-64 sm:h-80 rounded-2xl overflow-hidden shadow-2xl border-2 border-yellow-400/20 bg-red-900/60 flex items-center justify-center">
          <img src="./images/about-store.jpg" alt="徐虾客门店店内环境实拍" class="w-full h-full object-cover" />
          <!-- 【图片预留：请补传 about-store.jpg，推荐尺寸 800x600px】 -->
        </div>
      </div>
    </section>

    <!-- 招牌推荐区 -->
    <section id="menu" class="py-16 sm:py-24 bg-red-900/30 border-y border-red-900/50 px-4 sm:px-6">
      <div class="max-w-6xl mx-auto">
        <div class="text-center max-w-xl mx-auto mb-12 sm:mb-16">
          <span class="text-yellow-400 text-xs font-bold tracking-widest uppercase block mb-2">Signature Dishes</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">招牌必点推荐</h2>
          <p class="text-red-200/70 text-xs sm:text-sm mt-2">精选优质食材，传承经典湘味，带你品味热烈长沙</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 sm:gap-8">
          {dishes.map((dish) => (
            <div class="bg-red-900/50 rounded-xl overflow-hidden border border-red-800/80 hover:border-yellow-400/50 transition duration-300 group shadow-lg">
              <div class="h-52 sm:h-60 overflow-hidden relative bg-red-950 flex items-center justify-center">
                <img src={dish.image} alt={dish.name} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
                <span class="absolute top-3 left-3 bg-red-600 text-yellow-300 text-xs font-bold px-2.5 py-1 rounded-md shadow">
                  人气招牌
                </span>
              </div>
              <div class="p-5 sm:p-6">
                <h3 class="text-base sm:text-lg font-bold mb-2 text-white group-hover:text-yellow-300 transition">{dish.name}</h3>
                <p class="text-red-200/70 text-xs sm:text-sm font-light leading-relaxed">{dish.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 到店指引、地图快速导航与多平台外链悬停二维码区 -->
    <section id="contact" class="py-16 sm:py-24 max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <span class="text-yellow-400 text-xs font-bold tracking-widest uppercase block mb-2">Location & Connect</span>
      <h2 class="text-2xl sm:text-3xl font-extrabold mb-6 sm:mb-8 tracking-tight text-white">欢迎来门店打卡</h2>
      
      <div class="bg-red-900/40 border border-red-800/80 rounded-2xl p-6 sm:p-10 md:p-12 mb-8 text-left grid grid-cols-1 md:grid-cols-2 gap-8 shadow-xl">
        <div>
          <h3 class="text-yellow-300 font-bold mb-2 flex items-center gap-1.5 text-sm sm:text-base">
            📍 门店地址
          </h3>
          <p class="text-red-100 text-xs sm:text-sm mb-4">{restaurantInfo.address}</p>
          
          <!-- 地图一键快速导航按钮 -->
          <div class="flex gap-2 mb-6">
            <a href={restaurantInfo.mapLinks.amap} target="_blank" rel="noopener noreferrer" class="bg-amber-600 hover:bg-amber-500 text-white px-3 py-1.5 rounded text-xs font-semibold transition flex items-center gap-1">
              🗺️ 高德地图导航
            </a>
            <a href={restaurantInfo.mapLinks.baidu} target="_blank" rel="noopener noreferrer" class="bg-blue-600 hover:bg-blue-500 text-white px-3 py-1.5 rounded text-xs font-semibold transition flex items-center gap-1">
              🧭 百度地图导航
            </a>
          </div>

          <h3 class="text-yellow-300 font-bold mb-2 flex items-center gap-1.5 text-sm sm:text-base">
            ⏰ 营业时间
          </h3>
          <p class="text-red-100 text-xs sm:text-sm">周一至周日 11:00 - 次日 02:00（夜宵档营业）</p>
        </div>
        <div>
          <h3 class="text-yellow-300 font-bold mb-2 flex items-center gap-1.5 text-sm sm:text-base">
            📞 贵宾热线
          </h3>
          <p class="text-red-100 text-xs sm:text-sm mb-6">
            <a href={`tel:${restaurantInfo.phone}`} class="hover:text-yellow-400 underline">{restaurantInfo.phone}</a>
          </p>
          
          <h3 class="text-yellow-300 font-bold mb-3 text-sm sm:text-base">🔗 官方自媒体矩阵与外链</h3>
          
          <!-- 平台 Logo + 悬停二维码浮窗 -->
          <div class="flex flex-wrap gap-3 items-center mt-2">
            {restaurantInfo.socialLinks.map((item) => (
              <div class="relative group">
                <a href={item.url} target="_blank" rel="noopener noreferrer" 
                   class="flex items-center gap-1.5 text-xs bg-red-800/80 hover:bg-yellow-400 hover:text-red-950 text-red-100 font-medium px-3.5 py-2 rounded-full transition border border-yellow-400/30 shadow">
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
                  </svg>
                  <span>{item.name}</span>
                </a>

                <!-- 悬停二维码浮窗 -->
                <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block z-50 p-2 bg-white rounded-xl shadow-2xl border border-stone-200 text-center w-32">
                  <img src={item.qrcode} alt={`${item.name}二维码`} class="w-28 h-28 object-contain mx-auto rounded" />
                  <p class="text-[10px] text-stone-700 mt-1 font-semibold">扫码关注{item.name}</p>
                </div>
              </div>
            ))}
          </div>
          <p class="text-[10px] text-red-200/50 mt-2">
            💡 提示：电脑端鼠标悬停图标可查看对应二维码；图片需放置于 <code class="bg-red-900 px-1 rounded">public/images/</code> 目录下（推荐尺寸：300x300像素）。
          </p>
        </div>
      </div>
    </section>

    <!-- 底部版权 -->
    <footer class="bg-red-950 py-8 border-t border-red-900 text-center text-red-300/60 text-xs font-light px-4">
      <p>© {new Date().getFullYear()} {restaurantInfo.name}. All rights reserved. 纯静态宣传主页</p>
    </footer>

  </body>
</html>
